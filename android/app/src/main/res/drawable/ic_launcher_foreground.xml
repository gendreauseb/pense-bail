<?xml version="1.0" encoding="utf-8"?>
<!-- Premier plan de l'icône adaptative : le logo (post-it jaune en forme de
     maison, coin plié, coche bleu canard), dessiné dans une tuile de 100
     unités ramenée à 60 dp (dans la zone sûre de 66 dp), au centre du cadre
     de 108 dp.
     Même géométrie que LogoPenseBail (lib/core/widgets/composants.dart). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.6"
        android:scaleY="0.6"
        android:translateX="24"
        android:translateY="24">
        <path
            android:pathData="M50,16L82,44L82,70L68,84L18,84L18,44Z"
            android:fillColor="@color/logo_note"
            android:strokeColor="@color/logo_note"
            android:strokeWidth="4"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M82,70L68,70L68,84Z"
            android:fillColor="@color/logo_pli"
            android:strokeColor="@color/logo_pli"
            android:strokeWidth="3"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M35,63L45,72L64,53"
            android:strokeColor="@color/ic_launcher_background"
            android:strokeWidth="7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
