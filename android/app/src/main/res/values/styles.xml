<?xml version="1.0" encoding="utf-8"?>
<!-- Thèmes affichés avant et derrière Flutter. L'application reste claire
     en mode sombre (design-system.md §10) : pas de variante values-night. -->
<resources>
    <!-- Pendant le démarrage (Android 7 à 11) ; retiré à la première image
         de Flutter. Android 12 et plus : values-v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Derrière l'interface Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/fond_lancement</item>
    </style>
</resources>
